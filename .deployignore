# rsync now ships dist/ (built by build.js) rather than the repo root, so
# most repo plumbing can no longer leak by construction. These entries stay
# for two reasons: belt-and-braces, and — the important one — rsync never
# DELETES a file it has been told to exclude, so config.php, .ratelimit/ and
# .well-known/ survive a pruning run.

# --- repo plumbing, has no business on a web server ---
.git/
.github/
.gitignore
.gitattributes
.deployignore
.vscode/
_to_delete/

# --- THE SECRET. Lives only on the server. Never sync, never delete. ---
config.php

# --- the template. Harmless (placeholder key only), but there is no reason
#     to serve a map of the config layout to the public web. ---
config.sample.php

# --- runtime state written by daanaa.php on the server ---
.ratelimit/

# --- Let's Encrypt ACME challenge dir. Deleting this can break
#     certificate renewal. Never sync, never delete. ---
.well-known/

# --- i18n build sources (only the built pages should ship) ---
node_modules/
package.json
package-lock.json
build.js
template.html
i18n/

# --- documentation ---
*.md
